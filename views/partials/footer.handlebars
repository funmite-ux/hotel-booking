<div class="modal-backdrop" id="modal-backdrop">
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <button
      class="modal-close"
      id="modal-close"
      type="button"
      aria-label="Close"
    >
      ×
    </button>
    <p class="eyebrow">Welcome back</p>
    <h2 id="modal-title">Log in to roam.</h2>
    <p id="modal-message">
      Save stays, manage bookings and keep your travel ideas in one place.
    </p>
    <form id="login-form">
      <label for="login-email">Email address</label><input
        id="login-email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      /><label for="login-password">Password</label><input
        id="login-password"
        type="password"
        placeholder="At least 6 characters"
        autocomplete="current-password"
        minlength="6"
        required
      />
      <p class="form-error" id="login-error" role="alert"></p>
      <button class="search-button" type="submit">
        Log in
        <span>↗</span>
      </button>
    </form>
    <small>Demo login: any valid email and a 6+ character password.</small>
  </div>
</div>